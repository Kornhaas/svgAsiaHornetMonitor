[Unit]
Description=Asia Hornet Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hornet
WorkingDirectory=/home/hornet/svgAsiaHornetMonitor
Environment=PATH=/home/hornet/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/hornet/.local/bin/uv run --locked --no-dev hornet-monitor
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
